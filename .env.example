# Copia este archivo como .env.local y pega la URL de tu Aplicación Web de Apps Script.
# La URL termina en /exec y se genera al implementar el backend (ver README, Paso 2).
# También puedes pegarla desde la app en Dashboard → Configuración (se guarda en el navegador).
NEXT_PUBLIC_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec
